<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cyyaw.admin</groupId>
        <artifactId>admin-parent</artifactId>
        <relativePath>../admin-parent</relativePath>
        <version>1.0.1</version>
    </parent>

    <artifactId>application-user</artifactId>
    <version>1.0.1</version>
    <packaging>jar</packaging>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <!-- 项目实体类统一模块 -->
        <dependency>
            <groupId>com.cyyaw.admin</groupId>
            <artifactId>admin-entity</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MyBatis-Plus：Spring Boot 4 原生 starter（注解 + BaseMapper，无 XML） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>3.5.17</version>
        </dependency>

        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- JWT：使用 gson 桥接（不引 jjwt-jackson），规避 Spring Boot 4(Jackson 3) 冲突 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-gson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cyyaw.admin</groupId>
            <artifactId>admin-common</artifactId>
            <version>1.0.1</version>
        </dependency>

        <dependency>
            <groupId>com.cyyaw.admin</groupId>
            <artifactId>admin-dao</artifactId>
            <version>1.0.1</version>
        </dependency>
        <dependency>
            <groupId>com.cyyaw.admin</groupId>
            <artifactId>admin-config</artifactId>
            <version>1.0.1</version>
            <scope>compile</scope>
        </dependency>



        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>

        <!-- 微信 SDK：小程序登录 -->
        <dependency>
            <groupId>com.github.binarywang</groupId>
            <artifactId>weixin-java-miniapp</artifactId>
            <version>4.8.0</version>
        </dependency>

        <!-- 微信 SDK：公众号网页授权登录 -->
        <dependency>
            <groupId>com.github.binarywang</groupId>
            <artifactId>weixin-java-mp</artifactId>
            <version>4.8.0</version>
        </dependency>

        <!-- 支付宝 SDK：登录换 code -->
        <dependency>
            <groupId>com.alipay.sdk</groupId>
            <artifactId>alipay-sdk-java</artifactId>
            <version>4.40.523.ALL</version>
            <exclusions>
                <!-- spring-jcl 已经提供了 commons-logging 的 API，重复的类会让日志桥接错乱 -->
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
                <!-- 与 weixin-java-common 传递进来的 org.dom4j:dom4j:2.1.3 同包名不同 groupId，必须排掉一个 -->
                <exclusion>
                    <groupId>dom4j</groupId>
                    <artifactId>dom4j</artifactId>
                </exclusion>
                <!--
                  与 weixin-java-mp 传递进来的 org.bouncycastle:bcprov-jdk18on 同包名（org.bouncycastle.*），
                  两个都在会导致重复类、到底加载哪个取决于 classpath 顺序。
                  支付宝这边只有 SM2/SM4/AntCert/KMS 那几个类用到它，都不在登录链路上，排掉即可。
                -->
                <exclusion>
                    <groupId>org.bouncycastle</groupId>
                    <artifactId>bcprov-jdk15on</artifactId>
                </exclusion>
            </exclusions>
        </dependency>


    </dependencies>


    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>


</project>
