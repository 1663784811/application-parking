<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.2</version>
        <relativePath/>
    </parent>

    <groupId>com.cyyaw.admin</groupId>
    <artifactId>admin-parent</artifactId>
    <version>1.0.1</version>
    <packaging>pom</packaging>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <modules>
        <!-- 实体类统一模块：被各服务依赖，需先构建 -->
        <module>../admin-entity</module>
        <module>../admin-common</module>
        <module>../admin-config</module>


        <module>../application-common-mqtt-client</module>

        <!--================     应用服务    =================-->
        <module>../application-common</module>
        <module>../application-user</module>
        <module>../application-order</module>
        <module>../application-parking</module>
        <module>../application-member</module>
        <module>../application-iot</module>


        <!--================       集群      ======================-->
        <module>../cloud-parent</module>


        <!-- ===============      单机        ===================== -->
        <module>../single-all</module>


        <!--        -->
        <module>../netty-application-mqtt</module>


        <!-- ===============      集群/单机接口调用        ===================== -->
        <module>../admin-interface</module>
        <!--    集群接口抽象层    -->
        <module>../cloud-interface-impl</module>
        <!--    单机接口抽象层    -->
        <module>../single-interface-impl</module>


    </modules>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>3.5.15</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>3.5.15</version>
            </dependency>


            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>3.0.1</version>
            </dependency>

            <!-- knife4j 网关聚合：Spring Cloud Gateway 反应式聚合下游 OpenAPI 文档 -->
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-gateway-spring-boot-starter</artifactId>
                <version>4.5.0</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>


</project>
