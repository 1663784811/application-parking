<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Parkingcamera" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- Home page theme: no action bar / title bar. -->
    <style name="Theme.Parkingcamera.NoActionBar" parent="Theme.Parkingcamera">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Fill the display cutout (notch/punch-hole) so there's no black bar in landscape. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/home_background</item>
    </style>

    <!-- Switch theme for dark settings panel -->
    <style name="SwitchTheme" parent="Theme.AppCompat.Light">
        <item name="colorControlActivated">#FF64B5F6</item>
        <item name="colorSwitchThumbNormal">#CCCCCC</item>
        <item name="android:colorForeground">#FFFFFF</item>
    </style>

    <!-- Switch theme for light (white) dialogs -->
    <style name="SwitchThemeLight" parent="Theme.AppCompat.Light">
        <item name="colorControlActivated">#FF2E7D32</item>
        <item name="colorSwitchThumbNormal">#FFFFFFFF</item>
        <item name="android:colorForeground">#FF424242</item>
    </style>
</resources>