<?xml version="1.0" encoding="utf-8"?>
<!-- Home page: camera preview letterboxed to the camera's aspect ratio. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.cyyaw.parking.camera.AspectRatioSurfaceView
        android:id="@+id/cameraSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Time display (top-right corner) -->
    <TextView
        android:id="@+id/timeDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="#66000000"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="00:00:00"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:visibility="visible" />

    <!-- Plate recognition result (top-left corner) -->
    <TextView
        android:id="@+id/plateResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="#66000000"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="未识别到车牌"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <!-- Detection box overlay (drawn on top of the preview) -->
    <com.cyyaw.parking.camera.PlateOverlayView
        android:id="@+id/plateOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Left side panel -->
    <LinearLayout
        android:id="@+id/leftPanel"
        android:layout_width="200dp"
        android:layout_height="150dp"
        android:layout_gravity="start"
        android:layout_marginStart="20dp"
        android:layout_marginTop="100dp"
        android:background="#99000000"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:visibility="visible">

        <ImageView
            android:id="@+id/barrierIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_barrier" />

        <TextView
            android:id="@+id/barrierStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="道闸关闭"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Bottom bar: camera selector, network status, settings -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:background="#B3000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- Left: camera switch icon -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/cameraSwitchIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_camera_switch"
                android:tint="#CCFFFFFF" />

            <TextView
                android:id="@+id/bottomCameraId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="CAM-001"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/bottomBarrierIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_barrier" />

            <TextView
                android:id="@+id/bottomBarrierId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="B-001"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Right: network status + settings -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/networkStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:text="网络已连接"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/settingsIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_settings"
                android:tint="#CCFFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Dimming overlay (hidden initially) -->
    <View
        android:id="@+id/settingsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone" />

    <!-- Settings sliding panel (off-screen to the right initially) -->
    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#E6101010"
        android:orientation="vertical"
        android:visibility="gone"
        android:translationX="300dp">

        <!-- Panel header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#1AFFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="设置"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/closePanel"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                android:tint="#CCFFFFFF" />
        </LinearLayout>

        <!-- Scrollable settings content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- Basic info (opens dialog): timestamp toggle / camera ID / barrier ID -->
                <LinearLayout
                    android:id="@+id/basicInfoRow"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="基础信息"
                            android:textColor="#CCFFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/basicInfoSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="未配置"
                            android:textColor="#80FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="#99FFFFFF" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginVertical="8dp"
                    android:background="#33FFFFFF" />

                <!-- Signaling server address (opens dialog) -->
                <LinearLayout
                    android:id="@+id/signalingServerRow"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="信令服务器"
                            android:textColor="#CCFFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/signalingServerSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="未配置"
                            android:textColor="#80FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="#99FFFFFF" />
                </LinearLayout>

                <!-- MQTT settings (opens dialog) -->
                <LinearLayout
                    android:id="@+id/mqttSettingsRow"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MQTT设置"
                            android:textColor="#CCFFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/mqttSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="未配置"
                            android:textColor="#80FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="#99FFFFFF" />
                </LinearLayout>

                <!-- License Plate Recognition callback URL (opens dialog) -->
                <LinearLayout
                    android:id="@+id/lprCallbackRow"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="车牌回调地址"
                            android:textColor="#CCFFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/lprCallbackSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="未配置"
                            android:textColor="#80FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="#99FFFFFF" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginVertical="8dp"
                    android:background="#33FFFFFF" />

                <!-- About -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:text="关于"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="16dp"
                    android:text="停车摄像头 v1.0"
                    android:textColor="#66FFFFFF"
                    android:textSize="12sp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</FrameLayout>
